// Doc : https://www.jenkins.io/doc/book/pipeline/syntax/
pipeline {
    agent any
    options { skipDefaultCheckout(true) }
    environment {
        SONAR_HOST_URL = 'http://sonarqube:9000'
    }
    stages {
        stage('Code') {
            steps {
                deleteDir()
                git url: 'http://gitlab-tp.lan.hazit.fr:8088/root/petclinic.git',
                    branch: 'master',
                    credentialsId: 'gitlab'
            }
        }
        stage('Compilation') {
            steps {
                sh 'mvn clean package -DskipTests'
                sh 'cp target/*.war application.war'
            }
        }
        stage('Qualité') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        set +x
                        sonar-scanner \
                          -Dsonar.projectKey=fil-rouge \
                          -Dsonar.sources=src/main \
                          -Dsonar.java.binaries=target/classes \
                          -Dsonar.scanner.skipJreProvisioning=true \
                          -Dsonar.qualitygate.wait=true
                    '''
                }
            }
        }
        stage('Archivage') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'artifactory', usernameVariable: 'ART_USER', passwordVariable: 'ART_PASSWORD')]) {
                    sh '''
                        set +x
                        curl -f --user "$ART_USER:$ART_PASSWORD" --upload-file application.war \
                          "http://artifactory:8081/artifactory/war-local/fil-rouge/$BUILD_NUMBER/application.war"
                    '''
                }
            }
        }
        stage('Déploiement') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'tomcat', usernameVariable: 'TOMCAT_USER', passwordVariable: 'TOMCAT_PASSWORD')]) {
                    sh '''
                        set +x
                        curl -f --user "$TOMCAT_USER:$TOMCAT_PASSWORD" --upload-file application.war \
                          'http://tomcat:8080/manager/text/deploy?path=/application&update=true' > deployment.txt
                        cat deployment.txt
                        grep -q '^OK -' deployment.txt
                    '''
                }
            }
        }
        stage('Sauvegarde MySQL') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'mysql', usernameVariable: 'DB_USER', passwordVariable: 'MYSQL_PWD')]) {
                    sh '''
                        set +x
                        umask 077
                        mariadb-dump --skip-ssl --host=mysql --user="$DB_USER" \
                          --single-transaction --no-tablespaces application > "/backups/application-$BUILD_NUMBER.sql"
                        gzip "/backups/application-$BUILD_NUMBER.sql"
                    '''
                }
            }
        }
    }
}
